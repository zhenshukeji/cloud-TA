# =====================================================================
# 云朵教务社区版 · Docker Compose 环境变量模板（脱敏模板）
# ---------------------------------------------------------------------
# 用法：
#   cp deploy/.env.example deploy/.env
#   编辑 deploy/.env，把下面所有 change-me / replace-me 换成你自己的值
#   deploy/.env 已在 .gitignore 内，不会被提交
#
# 本文件只含**变量名与虚构值**，不含任何真实凭据。
# 社区版运行所需的全部变量就是下面这些：不再有微信 / 支付 / 短信 / 地图 /
# 对象存储 / 监控平台的任何变量；后端启动时由 CommunityStartupGuard 硬校验。
# =====================================================================

# --- MySQL（容器内不对外发布端口） ---
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=yunduo_community
MYSQL_USER=community
MYSQL_PASSWORD=change-me-app-password

# --- Redis（同样不对外发布端口） ---
REDIS_PASSWORD=change-me-redis-password
# 独立逻辑库与 key 前缀：多实例共用一个 Redis 时靠这两项隔离
REDIS_DB=12
REDIS_CACHE_NAME=yunduo_community

# --- 令牌密钥 ---------------------------------------------------------
# 要求：长度 ≥ 32、不同字符 ≥ 8、不得是占位符特征串（启动时硬校验，不达标直接中止）。
# 生成：openssl rand -base64 48
# 下面这串只是「形状合规的哑值」，让空 .env 也能起来；**上线前必须替换**。
TOKEN_SECRET=community-local-verify-token-secret-0123456789abcdefXYZ

# --- 管理员初始口令 ---------------------------------------------------
# 只在「空库首次启动且库里还没有口令」那一次生效；之后重启不再需要它。
# 要求：长度 ≥ 10、至少含小写/大写/数字/符号中的 2 类、不等于 admin、不在弱口令清单内。
# 生成：openssl rand -base64 18
INITIAL_ADMIN_PASSWORD=change-this-Before-First-Boot-2026

# --- 对外端口与镜像标签 ---
HTTP_PORT=8080
IMAGE_TAG=v0.1.0
TZ=Asia/Shanghai

# --- 基础镜像（内网环境可换成自己的镜像源；留空则用默认值） ---
# MAVEN_IMAGE=maven:3.9-eclipse-temurin-8
# JRE_IMAGE=eclipse-temurin:8-jre-alpine
# NODE_IMAGE=node:22-alpine
# NGINX_IMAGE=nginx:1.27-alpine
