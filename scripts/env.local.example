# 社区版本地运行环境变量模板。
# 在仓库根目录执行：
# cp scripts/env.local.example scripts/env.local
# 编辑 scripts/env.local 后：set -a && source scripts/env.local && set +a
# 请先替换所有口令和令牌占位值；本地环境文件不提交仓库。

# --- 数据库（社区版专用库，前缀 yunduo_community） ---
export MYSQL_HOST=127.0.0.1
export MYSQL_PORT=3306
export MYSQL_DATABASE=yunduo_community_dev
export MYSQL_USER=community
export MYSQL_PASSWORD=change-me

# --- Redis（独立逻辑库 + 独立 key 前缀） ---
export REDIS_HOST=127.0.0.1
export REDIS_PORT=6379
export REDIS_PASSWORD=change-me
export JX_REDIS_DB=12
export JX_CACHE_NAME=yunduo_community

# --- 令牌密钥：必须是随机生成的高熵字符串（长度 ≥ 32、不同字符 ≥ 8、不得是占位符） ---
#     启动时由 CommunityStartupGuard 硬校验，示例值与短值会直接中止启动。
#     生成：openssl rand -base64 48
#     注意：下面这串只是「形状合规的哑值」，首次部署前必须替换成你自己的随机值。
export TOKEN_SECRET=community-local-verify-token-secret-0123456789abcdefXYZ

# --- 管理员初始口令：只在「首次启动且库里还没有口令」那一次生效 ---
#     要求：长度 ≥ 10，至少含小写/大写/数字/符号中的 2 类，不等于 admin，不在弱口令清单内。
#     生成：openssl rand -base64 18
export INITIAL_ADMIN_PASSWORD=replace-me-before-first-boot-2026

# --- 上传根目录（本地持久卷；Docker 部署时挂卷并把这里指到卷内路径） ---
export UPLOAD_ROOT=./file/
